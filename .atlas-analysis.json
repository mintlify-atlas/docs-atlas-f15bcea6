  "keyFeatures": [
    "Live template editing with Monaco editor and syntax highlighting",
    "Real-time preview of rendered agreements in HTML/PDF format",
    "Built-in sample templates (Hello World, NDA, Employment Offer, etc.)",
    "AI-powered assistant for template creation and debugging",
    "Shareable template links with compressed state",
    "Concerto model validation and error reporting",
    "Guided learning pathway with interactive tutorials",
    "Dark/light theme support",
    "Multi-panel resizable workspace"
  ],
  "publicApiSurface": [
    "TemplateMarkInterpreter - Template engine for processing TemplateMark",
    "ModelManager - Concerto model management and validation",
    "TemplateMarkTransformer - Convert markdown to TemplateMark DOM",
    "transform - Convert TemplateMark output to HTML/PDF",
    "Sample templates - Pre-built templates (helloworld, nda, employmentOffer, etc.)",
    "useAppStore - Zustand store for application state",
    "Share functionality - Generate compressed shareable links",
    "AI Assistant - Multi-provider LLM integration (OpenAI, Claude, Gemini, Mistral)",
    "Editors - MarkdownEditor, ConcertoEditor, JSONEditor components"
  ]
